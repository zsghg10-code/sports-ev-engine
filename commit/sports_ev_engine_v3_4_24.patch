+    out['scenario_candidate'] = out['v3_candidate'] = status in {'FINAL_BET','PROVISIONAL'}
+    out['scenario_parlay_eligible'] = out['v3_parlay_eligible'] = out['parlay_eligible'] = status == 'FINAL_BET'
